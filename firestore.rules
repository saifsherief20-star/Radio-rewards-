rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function staff(){return signedIn() && request.auth.token.active == true && request.auth.token.role in ['cashier','admin'];}
  function admin(){return signedIn() && request.auth.token.active == true && request.auth.token.role == 'admin';}
  match /customers/{id} {
   allow read: if admin() || (signedIn() && request.auth.uid == resource.data.authUid);
   allow create, update, delete: if admin();
  }
  match /transactions/{id} { allow read: if admin(); allow write: if false; }
  match /employees/{id} { allow read: if admin(); allow write: if admin(); }
  match /rewards/{id} { allow read: if signedIn(); allow write: if admin(); }
  match /settings/{id} { allow read: if signedIn(); allow write: if admin(); }
  match /auditLogs/{id} { allow read: if admin(); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}